{
  "name": "google-news-rss-radar",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "ner:up": "docker compose up -d --build ner",
    "db:indexes": "npm run db:indexes -w backend",
    "collect": "npm run collect -w backend --",
    "collect-batch": "npm run collect-batch -w backend --",
    "download": "npm run download -w backend --",
    "extract": "npm run extract -w backend --",
    "enrich": "npm run enrich -w backend --",
    "pipeline": "npm run pipeline -w backend --",
    "api": "npm run api -w backend",
    "dashboard": "npm run dev -w dashboard",
    "dev": "node scripts/dev.js",
    "stop": "node scripts/stop.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
